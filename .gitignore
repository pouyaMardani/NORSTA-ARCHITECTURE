# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# generated at build time by `prebuild` (scripts/make-og-images.mjs), next to
# the favicon rasters: the share plates are cut from photographs the repo
# already ships, so they are never committed as binaries.
public/images/og/

# the product plates, generated at build time by `prebuild`
# (scripts/make-product-plates.mjs) from the catalogue's own tint and slug, so
# a new product never needs a binary committed. Only the plates the script
# draws are ignored: `placeholder-*.png` (every product) and the one category
# plate that is still a stand-in (`category-tools.png`). The three real
# category photographs — category-materials.png, category-starter-kits.png and
# category-samples.png — are committed and are NOT ignored; the script skips
# them, so they are never drawn over.
public/images/products/placeholder-*.png
public/images/products/category-tools.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# one-off scratch files written next to the app (root-level `.tmp-*` only)
/.tmp-*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local reference capture (not part of the app)
/_ref
